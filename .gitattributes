# 统一换行与二进制标记（避免 Windows/Linux 协作时的 CRLF 噪音）
* text=auto

*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.vbs   text eol=crlf

# 二进制资源：不做换行转换
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ogg   binary
*.dat   binary
